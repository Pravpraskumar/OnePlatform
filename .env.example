# Single monorepo environment. Copy to .env for local development.

# Frontend and LAN access
VITE_APP_NAME=McDermott Unify
VITE_API_BASE=http://192.168.100.22:4000/api
VITE_CAPTUREPRO_API_BASE=http://192.168.100.22:4103/api
VITE_HOST=0.0.0.0
VITE_PORT=5173
VITE_ALLOWED_HOSTS=192.168.100.22
VITE_CORE_API_URL=http://192.168.100.22:4000
VITE_CAPTUREPRO_API_URL=http://192.168.100.22:4103

# Microsoft B2C frontend settings
VITE_B2C_TENANT_NAME=your-tenant
VITE_B2C_POLICY_SIGNUP_SIGNIN=B2C_1_signupsignin
VITE_B2C_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_B2C_API_SCOPE=https://your-tenant.onmicrosoft.com/core-api/access_as_user
VITE_ENABLE_B2C_LOGIN=false

# Optional delegated SharePoint access; use a separate, approved single-tenant SPA registration.
VITE_SHAREPOINT_ENABLED=false
VITE_SHAREPOINT_TENANT_ID=
VITE_SHAREPOINT_CLIENT_ID=
VITE_SHAREPOINT_ORGANISATION_ID=

# Shared HTTP settings
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173,http://192.168.100.22:5173

# Optional OIDC frontend callback target
OIDC_FRONTEND_URL=http://192.168.100.22:5173

# Service ports
CORE_PORT=4000
PRIME_PORT=4102
CAPTUREPRO_PORT=4103

# Databases
CORE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/platform_core
PRIME_DATABASE_URL=postgres://postgres:postgres@localhost:5432/prime
CAPTUREPRO_DATABASE_URL=postgres://postgres:postgres@localhost:5432/capturepro

# Proposed server-side Azure Cosmos DB for NoSQL export; not consumed by runtime yet.
# PostgreSQL remains the source of truth. Do not use VITE_ settings or account keys.
# This account requires Entra authentication and approved private-network access.
CAPTUREPRO_COSMOS_ENABLED=false
CAPTUREPRO_COSMOS_ENDPOINT=https://mdr-msdn-cmip-dev-cosmosdb01.documents.azure.com:443/
CAPTUREPRO_COSMOS_DATABASE=TestDB
CAPTUREPRO_COSMOS_CONTAINER=
CAPTUREPRO_COSMOS_PARTITION_KEY_PATH=/organisationId
# Leave blank for system-assigned identity; set the client UUID for user-assigned identity.
CAPTUREPRO_COSMOS_MANAGED_IDENTITY_CLIENT_ID=

CAPTUREPRO_SHAREPOINT_ENABLED=false
CAPTUREPRO_SHAREPOINT_SITE_URL=https://mcdermottinc.sharepoint.com/sites/ITPMO-AI-CommercialIntelligenceSystem-PRJ0079553
CAPTUREPRO_SHAREPOINT_LIBRARY=Shared Documents
CAPTUREPRO_SHAREPOINT_FOLDER=General/TG3-Build and Test Plan

# Azure AD B2C backend
B2C_TENANT_NAME=your-tenant
B2C_POLICY_NAME=B2C_1_signupsignin
B2C_CLIENT_ID=00000000-0000-0000-0000-000000000000
# B2C_ISSUER=
# B2C_JWKS_URI=

# Optional OIDC
OIDC_WELL_KNOWN=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_LABEL=Continue with your identity provider
OIDC_CALLBACK_URL=http://192.168.100.22:4000/api/auth/oidc/callback
OIDC_SKIP_VERIFY=false

# Authentication and encryption
LOCAL_JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
LOCAL_JWT_EXPIRES_IN=12h
CONNECTION_SECRET_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
# Shared by core and Capture-Pro for the internal Salesforce extract call; use a different long random value.
CAPTUREPRO_INTERNAL_API_KEY=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SERVICE_KEY

# Foundry chat runs server-side; restrict each configured agent to one approved organisation.
FOUNDRY_ENABLED=false
FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
FOUNDRY_AGENT_ID=
FOUNDRY_AGENT_NAME=
FOUNDRY_ORGANISATION_ID=
FOUNDRY_IDENTITY=azure-cli
FOUNDRY_MANAGED_IDENTITY_CLIENT_ID=

# Service-to-service URLs
CORE_API_URL=http://192.168.100.22:4000/api

# Platform behavior
NEXT_PRIVATE_SMTP_UNSAFE_IGNORE_TLS=false
SESSION_HEARTBEAT_WINDOW_SECONDS=120
SEED_ADMIN_EMAIL=admin@global.local
SEED_ADMIN_DISPLAY_NAME=Admin
SEED_ADMIN_PASSWORD=ChangeMe123!
# DB_RESET_CONFIRM=YES
