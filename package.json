{
  "name": "designer-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise multi-tenant SaaS platform monorepo (core backend, product services, frontend, shared packages).",
  "license": "UNLICENSED",
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "packages/*",
    "apps/core-backend",
    "apps/frontend",
    "apps/prime-service",
    "apps/capture-pro-service"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "dev": "npm run dev:capturepro",
    "dev:core": "npm run start:dev --workspace @platform/core-backend",
    "dev:prime": "npm run start:dev --workspace @platform/prime-service",
    "dev:capturepro": "concurrently -k -n core,capturepro,web -c blue,yellow,cyan \"npm:dev:core\" \"npm:dev:service:capturepro\" \"npm:dev:frontend\"",
    "dev:service:capturepro": "npm run start:dev --workspace @platform/capture-pro-service",
    "dev:frontend": "npm run dev --workspace @platform/frontend",
    "start:prod:core": "npm run start:prod --workspace @platform/core-backend",
    "start:prod:prime": "npm run start:prod --workspace @platform/prime-service",
    "start:prod:capturepro": "npm run start:prod --workspace @platform/capture-pro-service",
    "start:prod:frontend": "npm run start:prod --workspace @platform/frontend",
    "start:prod": "concurrently -k -n core,capturepro,web -c blue,yellow,cyan \"npm:start:prod:core\" \"npm:start:prod:capturepro\" \"npm:start:prod:frontend\"",
    "db:core:migrate": "npm run db:migrate --workspace @platform/core-backend",
    "db:core:seed": "npm run db:seed --workspace @platform/core-backend",
    "db:core:seed:capturepro-integrations": "npm run db:seed:capturepro-integrations --workspace @platform/core-backend",
    "db:capturepro:create": "npm run db:create --workspace @platform/capture-pro-service",
    "db:generate:all": "npm run db:generate --workspaces --if-present",
    "db:migrate:all": "npm run db:migrate --workspaces --if-present",
    "db:setup": "npm run db:migrate:all && npm run db:core:seed",
    "db:reset:core": "npm run db:reset --workspace @platform/core-backend",
    "db:reset:prime": "npm run db:reset --workspace @platform/prime-service",
    "db:reset:capturepro": "npm run db:reset --workspace @platform/capture-pro-service",
    "db:reset": "npm run db:reset:core && npm run db:reset:prime && npm run db:reset:capturepro && npm run db:migrate:all && npm run db:core:seed",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.0.1",
    "turbo": "^2.11.2"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@typespec/ts-http-runtime": "0.3.4"
  },
  "overrides": {
    "@typespec/ts-http-runtime": "0.3.4"
  }
}
