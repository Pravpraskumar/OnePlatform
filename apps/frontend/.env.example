# App metadata
VITE_APP_NAME=Designer Platform

# Core API base (proxied to :4000 in dev)
VITE_API_BASE=/api
# Vite host and port for both development and production preview.
# Use 0.0.0.0 to accept requests through the machine's LAN IP.
VITE_HOST=0.0.0.0
VITE_PORT=5173
VITE_CORE_API_URL=http://localhost:4000
VITE_CREDITGUARD_API_URL=http://localhost:4101
# For a backend on another machine, replace localhost with its IP address.

# ---- Azure AD B2C ----
VITE_B2C_TENANT_NAME=your-tenant
VITE_B2C_POLICY_SIGNUP_SIGNIN=B2C_1_signupsignin
VITE_B2C_CLIENT_ID=00000000-0000-0000-0000-000000000000
# API scope exposed by the core-backend app registration
VITE_B2C_API_SCOPE=https://your-tenant.onmicrosoft.com/core-api/access_as_user
