# ---- Core platform database ----
CORE_DATABASE_URL=postgres://postgres:Justsign@localhost:5432/core

# ---- HTTP ----
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ---- Azure AD B2C ----
# Tenant name without the .onmicrosoft.com suffix, e.g. "contosob2c"
B2C_TENANT_NAME=your-tenant
# The sign-up/sign-in user flow (policy) name, e.g. "B2C_1_signupsignin"
B2C_POLICY_NAME=B2C_1_signupsignin
# Application (client) ID registered in B2C for the API/SPA
B2C_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Derived issuer/JWKS are built from the values above; override only if needed
# B2C_ISSUER=
# B2C_JWKS_URI=

# ---- Local email/password auth ----
# Secret used to sign platform-issued JWTs for local sign-in sessions.
LOCAL_JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
LOCAL_JWT_EXPIRES_IN=12h

# ---- Secrets encryption (fallback when Key Vault is not configured) ----
# 32-byte key, base64 encoded. Used to encrypt product DB connection secrets at rest.
CONNECTION_SECRET_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# Shared service key required for CreditGuard-to-core Signit envelope requests.
CREDITGUARD_INTERNAL_API_KEY=REPLACE_WITH_A_LONG_RANDOM_SERVICE_KEY

# Emergency-only global override for SMTP servers with an untrusted certificate chain.
# Prefer installing the issuing CA or enabling the per-profile option temporarily.
NEXT_PRIVATE_SMTP_UNSAFE_IGNORE_TLS=false

# ---- Licensing ----
# A session is considered active if seen within this many seconds.
SESSION_HEARTBEAT_WINDOW_SECONDS=120

# ---- Default seed (Global org owner) ----
SEED_ADMIN_EMAIL=admin@global.local
SEED_ADMIN_DISPLAY_NAME=Admin
# Password for the seeded Admin local login; change it after first sign-in.
SEED_ADMIN_PASSWORD=ChangeMe123!
